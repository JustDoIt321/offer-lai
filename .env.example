# 复制为 .env.local 用于本地开发；部署到 Zeabur 时在服务环境变量中逐项配置

# DeepSeek 大模型 API Key（面试 AI 核心，必须配置）
DEEPSEEK_API_KEY=

# 管理端手动开通会员的密钥（通过 HTTP 头或 body 的 adminToken 传递）
ADMIN_TOKEN=

# 会员价格（人民币/月，默认 39）
PRICE_CNY=39

# 用户支付后联系你开通会员的联系方式（如微信号、邮箱、Telegram）
PAY_CONTACT=

# 支付与开通说明（展示在「开通会员」弹窗里）
PAY_NOTE=支付后请添加下方联系方式，提供你的注册邮箱，我们会为你手动开通会员。

# 数据库存储目录（Zeabur 请挂载持久化卷后指向该卷路径，如 /data）
DATA_DIR=